#!/usr/bin/env python3
"""Provision a Stalwart mailbox and its ERPNext/Raven records.

Usage: add-mail-user email@example.com "Display Name"
Secrets are loaded from the process environment or the ignored .env file.
"""

from __future__ import annotations

import json
import getpass
import os
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path(__file__).resolve().parents[1]


def setting(name: str, default: str | None = None) -> str:
    if value := os.environ.get(name):
        return value
    env_file = ROOT / ".env"
    if env_file.exists():
        for raw_line in env_file.read_text(encoding="utf-8-sig").splitlines():
            if raw_line.lstrip().startswith("#") or "=" not in raw_line:
                continue
            key, value = raw_line.split("=", 1)
            if key.strip() == name:
                return value.strip().strip("\"'")
    if default is not None:
        return default
    raise SystemExit(f"Missing required setting: {name}")


def run_json(arguments: list[str]) -> dict:
    result = subprocess.run(arguments, check=True, capture_output=True, text=True)
    return json.loads(result.stdout)


def sql_literal(value: str) -> str:
    return "'" + value.replace("\\", "\\\\").replace("'", "''") + "'"


if len(sys.argv) < 2:
    raise SystemExit('Usage: add-mail-user email@example.com "Display Name"')

email = sys.argv[1].strip().lower()
if "@" not in email:
    raise SystemExit("A valid email address is required")

display_name = sys.argv[2] if len(sys.argv) > 2 else email.split("@", 1)[0].replace(".", " ").title()
first_name = display_name.split()[0]
domain = email.split("@", 1)[1]
configured_domain = setting("STALWART_MAIL_DOMAIN", domain)
if domain != configured_domain:
    raise SystemExit(f"Email domain must be {configured_domain}")

recovery_admin = setting("STALWART_RECOVERY_ADMIN")
if ":" not in recovery_admin:
    raise SystemExit("STALWART_RECOVERY_ADMIN must use the form username:password")
admin_user, admin_password = recovery_admin.split(":", 1)

stalwart_url = setting("STALWART_ADMIN_URL", "https://127.0.0.1:4443")
stalwart_account_id = setting("STALWART_ACCOUNT_ID", "d333333")
backend_container = setting("FRAPPE_BACKEND_CONTAINER", "nepal-compliance-backend-1")
site = setting("FRAPPE_SITE", "frontend")
bench = "/home/frappe/frappe-bench"
mailbox_password = getpass.getpass("Mailbox password (input hidden): ")
if len(mailbox_password) < 12:
    raise SystemExit("Mailbox password must be at least 12 characters")

print(f"Provisioning {email} ({display_name})...")
device = run_json(
    [
        "curl", "-fsSk", "-X", "POST", f"{stalwart_url}/auth/device",
        "-H", "Content-Type: application/x-www-form-urlencoded",
        "-d", "client_id=stalwart-web-admin",
    ]
)
subprocess.run(
    [
        "curl", "-fsSk", "-X", "POST", f"{stalwart_url}/api/auth",
        "-H", "Content-Type: application/json",
        "-d", json.dumps(
            {
                "type": "authDevice",
                "accountName": admin_user,
                "accountSecret": admin_password,
                "code": device["user_code"],
            }
        ),
    ],
    check=True,
    capture_output=True,
)
time.sleep(2)
token = run_json(
    [
        "curl", "-fsSk", "-X", "POST", f"{stalwart_url}/auth/token",
        "-H", "Content-Type: application/x-www-form-urlencoded",
        "-d", "grant_type=urn:ietf:params:oauth:grant-type:device_code"
        f"&device_code={device['device_code']}&client_id=stalwart-web-admin",
    ]
)["access_token"]

payload = {
    "using": ["urn:ietf:params:jmap:core"],
    "methodCalls": [
        [
            "x:Account/set",
            {
                "accountId": stalwart_account_id,
                "create": {
                    "new": {
                        "@type": "User",
                        "name": email,
                        "emails": [email],
                        "description": display_name,
                        "password": mailbox_password,
                    }
                },
            },
            "0",
        ]
    ],
}
response = run_json(
    [
        "curl", "-fsSkL", "-H", f"Authorization: Bearer {token}",
        "-H", "Content-Type: application/json", "-d", json.dumps(payload),
        f"{stalwart_url}/jmap",
    ]
)
result = response["methodResponses"][0][1]
if not result.get("created"):
    error = next(iter(result.get("notCreated", {}).values()), {})
    if "already exists" not in error.get("description", "").lower():
        raise SystemExit(f"Stalwart mailbox creation failed: {error.get('description', 'unknown error')}")

email_sql = f"""
INSERT IGNORE INTO `tabEmail Account`
    (name, email_account_name, email_id, domain, enable_outgoing, enable_incoming,
     smtp_server, smtp_port, use_tls, use_ssl_for_outgoing, email_server,
     incoming_port, use_imap, use_ssl, login_id, password, creation, modified,
     docstatus, idx, owner, modified_by)
VALUES
    ({sql_literal(display_name)}, {sql_literal(display_name)}, {sql_literal(email)}, {sql_literal(domain)}, 1, 1,
     'stalwart', 25, 0, 0, 'stalwart', 143, 1, 0, {sql_literal(email)},
     {sql_literal(mailbox_password)}, NOW(), NOW(), 0, 0, 'Administrator', 'Administrator');
"""
raven_sql = f"""
INSERT IGNORE INTO `tabRaven User`
    (name, user, full_name, first_name, enabled, creation, modified, docstatus,
     idx, owner, modified_by, type)
VALUES
    ({sql_literal(email)}, {sql_literal(email)}, {sql_literal(display_name)}, {sql_literal(first_name)}, 1,
     NOW(), NOW(), 0, 0, 'Administrator', 'Administrator', 'User');
INSERT IGNORE INTO `tabHas Role` (name, parent, parenttype, parentfield, role)
VALUES (UUID(), {sql_literal(email)}, 'User', 'roles', 'Raven User');
"""
for sql in (email_sql, raven_sql):
    subprocess.run(
        [
            "docker", "exec", "-i", backend_container, "bash", "-lc",
            f"cd {bench} && bench --site {site} mariadb",
        ],
        input=sql,
        text=True,
        check=True,
    )

print(f"Mailbox, ERPNext Email Account, and Raven access created for {email}.")
